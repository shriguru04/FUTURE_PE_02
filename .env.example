# Copy to .env and edit. NEVER commit .env. All values below are placeholders.

# --- Database (docker compose builds DATABASE_URL from these) ---
POSTGRES_USER=adcraft
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=adcraft

# --- App ---
APP_ENV=development            # development | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
COOKIE_SECURE=false            # MUST be true in production (HTTPS)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
WEB_PORT=8080

# --- AI provider (OpenAI-compatible; pick ONE block) ---
LLM_PROVIDER=openai_compat     # openai_compat | mock (mock = dev only, refused in production)
LLM_API_KEY=
# OpenAI GPT:
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# xAI Grok (check xAI docs for current model names, pricing and quotas):
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=<grok-model-name>
# Local (Ollama / vLLM), no key needed:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- Rate limiting (in-memory; per API instance) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_GENERATE=10/minute
